   \"dtype\": \"number\",\n        \"std\": 0.004611830315273076,\n        \"min\": 0.05753853779486955,\n        \"max\": 0.06854448575227567,\n        \"num_unique_values\": 5,\n        \"samples\": [\n          0.05753853779486955,\n          0.06854161320212629,\n          0.06854448575227567\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"Epoch\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.0,\n        \"min\": 2461234.5,\n        \"max\": 2461234.5,\n        \"num_unique_values\": 1,\n        \"samples\": [\n          2461234.5\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"Altitude\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 351.25054854826584,\n        \"min\": 356.39227891306837,\n        \"max\": 1189.8795529714898,\n        \"num_unique_values\": 5,\n        \"samples\": [\n          1189.8795529714898\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{}}]},{"cell_type":"markdown","metadata":{"id":"6729f6f6"},"source":["### 🔄 Model Validation\n","Before final training, we perform 5-fold cross-validation on the full training set to ensure the model generalizes well across different subsets of the data."]},{"cell_type":"code","metadata":{"id":"535168a3","executionInfo":{"status":"ok","timestamp":1783984469856,"user_tz":-180,"elapsed":5,"user":{"displayName":"Amanuel Mekonnen","userId":"06321938012396282698"}}},"source":["# Cell moved or content cleared to fix execution order error."],"execution_count":10,"outputs":[]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"38c19020","executionInfo":{"status":"ok","timestamp":1783984479784,"user_tz":-180,"elapsed":7072,"user":{"displayName":"Amanuel Mekonnen","userId":"06321938012396282698"}},"outputId":"465427d2-47bf-4fcc-9caa-d906a445d6f9"},"source":["from sklearn.model_selection import cross_val_score\n","\n","# Identify feature types\n","numeric_features = X.select_dtypes(include=['int64', 'float64']).columns.tolist()\n","\n","# Define the transformers\n","numeric_transformer = Pipeline(steps=[\n","    ('scaler', StandardScaler())\n","])\n","\n","# Combine into a ColumnTransformer\n","preprocessor = ColumnTransformer(\n","    transformers=[\n","        ('num', numeric_transformer, numeric_features),\n","    ])\n","\n","# Create the XGBoost pipeline\n","XRfor_model = Pipeline(steps=[\n","    ('preprocessor', preprocessor),\n","    ('regressor', XGBClassifier(n_estimators=100, random_state=42, eval_metric='logloss'))\n","])\n","\n","# Perform 5-fold cross-validation right after definition(might turn this into 10 if i find a larger dataset)\n","print(\"--- PERFORMING CROSS-VALIDATION ---\")\n","cv_scores = cross_val_score(XRfor_model, X_full_train, Y_full_train, cv=5, scoring='roc_auc')\n","print(f\"Mean ROC AUC: {cv_scores.mean():.4f} (+/- {cv_scores.std():.4f})\")\n","\n","# Retrain the model on BOTH training and validation data (80% of total data)\n","XRfor_model.fit(X_full_train, Y_full_train)\n","\n","print(\"\\nXGBoost model retrained on full training set!\")\n","print(f\"Combined Set Accuracy: {XRfor_model.score(X_full_train, Y_full_train):.4f}\")"],"execution_count":11,"outputs":[{"output_type":"stream","name":"stdout","text":["--- PERFORMING CROSS-VALIDATION ---\n","Mean ROC AUC: 0.9048 (+/- 0.0022)\n","\n","XGBoost model retrained on full training set!\n","Combined Set Accuracy: 0.9318\n"]}]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"collapsed":true,"id":"064fa026","executionInfo":{"status":"ok","timestamp":1783984479845,"user_tz":-180,"elapsed":63,"user":{"displayName":"Amanuel Mekonnen","userId":"06321938012396282698"}},"outputId":"0abc22d0-b2a6-4854-b71c-93e88bf4ac2c"},"source":["\n","\n","# Final evaluation on the TEST set\n","y_test_pred = XRfor_model.predict(X_test)\n","y_test_pred_proba = XRfor_model.predict_proba(X_test)[:, 1]\n","\n","# Calculate Metrics\n","test_roc_auc = roc_auc_score(Y_test, y_test_pred_proba)\n","print(\"--- FINAL TEST SET RESULTS ---\")\n","print(f\"Test ROC AUC Score: {test_roc_auc:.4f}\")\n","print(\"\\nClassification Report:\")\n","print(classification_report(Y_test, y_test_pred))\n","\n","# Display Confusion Matrix\n","print(\"Confusion Matrix:\")\n","print(confusion_matrix(Y_test, y_test_pred))"],"execution_count":12,"outputs":[{"output_type":"stream","name":"stdout","text":["--- FINAL TEST SET RESULTS ---\n","Test ROC AUC Score: 0.9132\n","\n","Classification Report:\n","              precision    recall  f1-score   support\n","\n","           0       0.89      0.95      0.92      2540\n","           1       0.74      0.56      0.64       657\n","\n","    accuracy                           0.87      3197\n","   macro avg       0.82      0.75      0.78      3197\n","weighted avg       0.86      0.87      0.86      3197\n","\n","Confusion Matrix:\n","[[2412  128]\n"," [ 289  368]]\n"]}]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"e3ba2ad3","executionInfo":{"status":"ok","timestamp":1783984479877,"user_tz":-180,"elapsed":31,"user":{"displayName":"Amanuel Mekonnen","userId":"06321938012396282698"}},"outputId":"8c49b4da-0a8b-4f6b-db2d-bd1740524ee6"},"source":["def predict_satellite_decay_risk(sat_name, tle_lines, pipeline):\n","    try:\n","        # Find the satellite in the raw TLE lines\n","        name_idx = tle_lines.index(sat_name)\n","        line1 = tle_lines[name_idx + 1]\n","        line2 = tle_lines[name_idx + 2]\n","\n","        # Parse with Satrec\n","        s = Satrec.twoline2rv(line1, line2)\n","\n","        # Calculate features manually for the single instance\n","        mu_min = 398600.4418 * 60**2\n","        Re = 6378.0\n","\n","        ecc = s.ecco\n","        inc = s.inclo\n","        mm = s.no_kozai\n","        epoch = s.jdsatepoch\n","        sma = (mu_min / (mm**2))**(1/3)\n","        alt = sma - Re\n","\n","        # Create a DataFrame for prediction matching training columns\n","        input_df = pd.DataFrame([{\n","            'Eccentricity': ecc,\n","            'Inclination': inc,\n","            'Mean Motion': mm,\n","            'Epoch': epoch,\n","            'Altitude': alt\n","        }])\n","\n","        # Get probability\n","        risk_prob = pipeline.predict_proba(input_df)[0, 1]\n","        return risk_prob\n","    except Exception as e:\n","        print(f\"Error processing {sat_name}: {e}\")\n","        return None\n","\n","# Test the wrapper on a satellite\n","sat_name = \"CALSPHERE 1\"\n","risk_score = predict_satellite_decay_risk(sat_name, lines, XRfor_model)\n","\n","if risk_score is not None:\n","    print(f\"\\n======================================\")\n","    print(f\"📡 SATELLITE: {sat_name}\")\n","    print(f\"📊 30-Day Decay Risk Probability: {risk_score * 100:.2%}\")\n","\n","    if risk_score > 0.5:\n","        print(\"⚠️ STATUS: HIGH RISK — Monitor orbital parameters closely.\")\n","    else:\n","        print(\"✅ STATUS: STABLE — Orbit shows safe structural parameters.\")\n","    print(f\"======================================\")"],"execution_count":13,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","======================================\n","📡 SATELLITE: CALSPHERE 1\n","📊 30-Day Decay Risk Probability: 40.87%\n","✅ STATUS: STABLE — Orbit shows safe structural parameters.\n","======================================\n"]}]},{"cell_type":"code","source":["#Github push column\n","import os\n","from google.colab import userdata\n","import pandas as pd\n","\n","# --- CONFIGURATION ---\n","repo_name = \"Satellite_Health_Monitor\"\n","user_name = \"Time-Amanu\"\n","user_email = \"improvementalchemy@gmail.com\"\n","\n","def push_to_github():\n","    try:\n","        token = userdata.get('GITHUB_TOKEN')\n