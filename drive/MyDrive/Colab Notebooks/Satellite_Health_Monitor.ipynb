  90.2206  72.5514 0024576 187.0091 244.1973 13.76654964 76019\n"]}]},{"cell_type":"code","source":["satellites = []\n","\n","# Iterate through the lines, taking 3 lines at a time (Name, TLE Line 1, TLE Line 2)\n","for i in range(0, len(lines), 3):\n","    # Ensure we have enough lines for a complete TLE set\n","    if i + 2 < len(lines):\n","        name = lines[i]\n","        line1 = lines[i+1]\n","        line2 = lines[i+2]\n","\n","        # Create a Satrec object\n","        try:\n","            satellite = Satrec.twoline2rv(line1, line2)\n","            satellites.append({'name': name, 'satellite': satellite})\n","        except Exception as e:\n","            print(f\"Error parsing TLE for {name}: {e}\")\n","    else:\n","        print(f\"Skipping incomplete TLE data starting at line {i}: {lines[i:]}\")\n","\n","print(f\"Successfully parsed {len(satellites)} satellites.\")\n","\n","# Display the first few parsed satellites\n","if satellites:\n","    print(\"\\nFirst 5 parsed satellites:\")\n","    for sat_data in satellites[:5]:\n","        print(f\"Name: {sat_data['name']}\")\n","        # You can access orbital elements from sat_data['satellite'] if needed\n","        # For example, to print the epoch:\n","        # print(f\"  Epoch: {sat_data['satellite'].epoch}\")"],"metadata":{"id":"DHzOGVjXJQSc","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1784585471684,"user_tz":-180,"elapsed":202,"user":{"displayName":"Amanuel Mekonnen","userId":"06321938012396282698"}},"outputId":"6557cfcc-3055-4913-fe0f-47fa296d1af2"},"execution_count":5,"outputs":[{"output_type":"stream","name":"stdout","text":["Successfully parsed 16058 satellites.\n","\n","First 5 parsed satellites:\n","Name: CALSPHERE 1\n","Name: CALSPHERE 2\n","Name: LCS 1\n","Name: TEMPSAT 1\n","Name: CALSPHERE 4A\n"]}]},{"cell_type":"code","source":["names = pd.Series([s['name'] for s in satellites])\n","bstar = []\n","Eccentricity = []\n","Inclination = []\n","Mea