83358826849824,\n          0.06569700525045707,\n          0.06613522413347736\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"Epoch\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.4472135954999579,\n        \"min\": 2461240.5,\n        \"max\": 2461241.5,\n        \"num_unique_values\": 2,\n        \"samples\": [\n          2461240.5,\n          2461241.5\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"Altitude\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 33.7652616932861,\n        \"min\": 470.8381984626085,\n        \"max\": 549.6038273838367,\n        \"num_unique_values\": 5,\n        \"samples\": [\n          470.8381984626085,\n          549.6038273838367\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{}}]},{"cell_type":"markdown","metadata":{"id":"6729f6f6"},"source":["### 🔄 Model Validation\n","Before final training, we perform 5-fold cross-validation on the full training set to ensure the model generalizes well across different subsets of the data."]},{"cell_type":"code","metadata":{"id":"535168a3","executionInfo":{"status":"ok","timestamp":1784585472179,"user_tz":-180,"elapsed":30,"user":{"displayName":"Amanuel Mekonnen","userId":"06321938012396282698"}}},"source":["# Cell moved or content cleared to fix execution order error."],"execution_count":10,"outputs":[]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"38c19020","executionInfo":{"status":"ok","timestamp":1783984479784,"user_tz":-180,"elapsed":7072,"user":{"displayName":"Amanuel Mekonnen","userId":"06321938012396282698"}},"outputId":"465427d2-47bf-4fcc-9caa-d906a445d6f9"},"source":["from sklearn.model_selection import cross_val_score\n","\n","# Identify feature types\n","numeric_features = X.select_dtypes(include=['int64', 'float64']).columns.tolist()\n","\n","# Define the transformers\n","numeric_transformer = Pipeline(steps=[\n","    ('scaler', StandardScaler())\n","])\n","\n","# Combine into a ColumnTransformer\n","preprocessor = ColumnTransformer(\n","    transformers=[\n","        ('num', numeric_transformer, numeric_features),\n","    ])\n","\n","# Create the XGBoost pipeline\n","XRfor_model = Pipeline(steps=[\n","    ('preprocessor', preprocessor),\n","    ('regressor', XGBClassifier(n_estimators=100, random_state=42, eval_metric='logloss'))\n","])\n","\n","# Perform 5-fold cross-validation right after definition(might turn this into 10 if i find a larger dataset)\n","print(\"--- PERFORMING CROSS-VALIDATION ---\")\n","cv_scores = cross_val_score(XRfor_model, X_full_train, Y_full_train, cv=5, scoring='roc_auc')\n","print(f\"Mean ROC AUC: {cv_scores.mean():.4f} (+/- {cv_scores.std():.4f})\")\n","\n","# Retrain the model on BOTH training and validation data (80% of total data)\n","XRfor_model.fit(X_full_train, Y_full_train)\n","\n","print(\"\\nXGBoost model retrained on full training set!\")\n","print(f\"Combined Set Accuracy: {XRfor_model.score(X_full_train, Y_full_train):.4f}\")"],"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["--- PERFORMING CROSS-VALIDATION ---\n","Mean ROC AUC: 0.9048 (+/- 0.0022)\n","\n","XGBoost model retrained on full training set!\n","Combined Set Accuracy: 0.9318\n"]}]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"collapsed":true,"id":"064fa026","executionInfo":{"status":"ok","timestamp":1783984479845,"user_tz":-180,"elapsed":63,"user":{"displayName":"Amanuel Mekonnen","userId":"06321938012396282698"}},"outputId":"0abc22d0-b2a6-4854-b71c-93e88bf4ac2c"},"source":["\n","\n","# Final evaluation on the TEST set\n","y_test_pred = XRfor_model.predict(X_test)\n","y_test_pred_proba = XRfor_model.predict_proba(X_test)[:, 1]\n","\n","# Calculate Metrics\n","test_roc_auc = roc_auc_score(Y_test, y_test_pred_proba)\n","print(\"--- FINAL TEST SET RESULTS ---\")\n","print(f\"Test ROC AUC Score: {test_roc_auc:.4f}\")\n","print(\"\\nClassification Report:\")\n","print(classification_report(Y_test, y_test_pred))\n","\n","# Display Confusion Matrix\n","print(\"Confusion Matrix:\")\n","print(confusion_matrix(Y_test, y_test_pred))"],"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["--- FINAL TEST SET RESULTS ---\n","Test ROC AUC Score: 0.9132\n","\n","Classification Report:\n","              precision    recall  f1-score   support\n","\n","           0       0.89      0.95      0.92      2540\n","           1       0.74      0.56      0.64       657\n","\n","    accuracy                           0.87      3197\n","   macro avg       0.82      0.75      0.78      3197\n","weighted avg       0.86      0.87      0.86      3197\n","\n","Confusion Matrix:\n","[[2412  128]\n"," [ 289  368]]\n"]}]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"e3ba2ad3","executionInfo":{"status":"ok","timestamp":1783984479877,"user_tz":-180,"elapsed":31,"user":{"displayName":"Amanuel Mekonnen","userId":"06321938012396282698"}},"outputId":"8c49b4da-0a8b-4f6b-db2d-bd1740524ee6"},"source":["def predict_satellite_decay_risk(sat_name, tle_lines, pipeline):\n","    try:\n","        # Find the satellite in the raw TLE lines\n","        name_idx = tle_lines.index(sat_name)\n","        line1 = tle_lines[name_idx + 1]\n","        line2 = tle_lines[name_idx + 2]\n","\n","        # Parse with Satrec\n","        s = Satrec.twoline2rv(line1, line2)\n","\n","        # Calculate features manually for the single instance\n","        mu_min = 398600.4418 * 60**2\n","        Re = 6378.0\n","\n","        ecc = s.ecco\n","        inc = s.inclo\n","        mm = s.no_kozai\n","        epoch = s.jdsatepoch\n","        sma = (mu_min / (mm**2))**(1/3)\n","        alt = sma - Re\n","\n","        # Create a DataFrame for prediction matching training columns\n","        input_df = pd.DataFrame([{\n","            'Eccentricity': ecc,\n","            'Inclination': inc,\n","            'Mean Motion': mm,\n","            'Epoch': epoch,\n","            'Altitude': alt\n","        }])\n","\n","        # Get probability\n","        risk_prob = pipeline.predict_proba(input_df)[0, 1]\n","        return risk_prob\n","    except Exception as e:\n","        print(f\"Error processing {sat_name}: {e}\")\n","        return None\n","\n","# Test the wrapper on a satellite\n","sat_name = \"CALSPHERE 1\"\n","risk_score = predict_satellite_decay_risk(sat_name, lines, XRfor_model)\n","\n","if risk_score is not None:\n","    print(f\"\\n======================================\")\n","    print(f\"📡 SATELLITE: {sat_name}\")\n","    print(f\"📊 30-Day Decay Risk Probability: {risk_score * 100:.2%}\")\n","\n","    if risk_score > 0.5:\n","        print(\"⚠️ STATUS: HIGH RISK — Monitor orbital parameters closely.\")\n","    else:\n","        print(\"✅ STATUS: STABLE — Orbit shows safe structural parameters.\")\n","    print(f\"======================================\")"],"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","======================================\n","📡 SATELLITE: CALSPHERE 1\n","📊 30-Day Decay Risk Probability: 40.87%\n","✅ STATUS: STABLE — Orbit shows safe structural parameters.\n","======================================\n"]}]},{"cell_type":"code","source":["#Github push column\n","import os\n","from google.colab import userdata\n","import pandas as pd\n","\n","# --- CONFIGURATION ---\n","repo_name = \"Satellite_Health_Monitor\"\n","user_name = \"Time-Amanu\"\n","user_email = \"improvementalchemy@gmail.com\"\n","\n","def push_to_github():\n","    try:\n","        token = userdata.get('GITHUB_TOKEN')\n","    except:\n","        print(\"❌ GITHUB_TOKEN not found in Secrets!\")\n","        return\n","\n","    # 1. Configure Git Identity\n","    !git config --global user.email \"{user_email}\"\n","    !git config --global user.name \"{user_name}\"\n","\n","    # 2. Setup Remote\n","    remote_url = f\"https://{user_name}:{token}@github.com/{user_name}/{repo_name}.git\"\n","    if not os.path.exists('.git'):\n","        !git init\n","        !git remote add origin {remote_url}\n","    else:\n","        !git remote set-url origin {remote_url}\n","\n","    # 3. Cleanup unwanted Colab files and stage ONLY project files\n","    print(\"--- Cleaning up and staging project files ---\")\n","    # Remove sample_data and .config from git index if they were added\n","    !git rm -r --cached sample_data .config 2>/dev/null\n","\n","    # Add only the notebook and potential python scripts\n","    !git add *.ipynb 2>/dev/null\n","    !git add *.py 2>/dev/null\n","\n","    !git status\n","\n","    # 4. Commit and Force Push\n","    print(f\"--- Committing as: {user_email} ---\")\n","    !git commit --allow-empty -m \"considered cross validation\"\n","    !git branch -M main\n","    !git push -u origin main --force\n","\n","    print(f\"\\n✅ Push successful! The random CSVs should now be gone from https://github.com/{user_name}/{repo_name}\")\n","\n","push_to_github()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"eriSIoY_INxp","executionInfo":{"status":"ok","timestamp":1783984516371,"user_tz":-180,"elapsed":3679,"user":{"displayName":"Amanuel Mekonnen","userId":"06321938012396282698"}},"outputId":"f6f9c1e9-277e-4d31-ba31-b90c608c6616"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["\u001b[33mhint: Using 'master' as the name for the initial branch. This default branch name\u001b[m\n","\u001b[33mhint: is subject to change. To configure the initial branch name to use in all\u001b[m\n","\u001b[33mhint: of your new repositories, which will suppress this warning, call:\u001b[m\n","\u001b[33mhint: \u001b[m\n","\u001b[33mhint: \tgit config --global init.defaultBranch <name>\u001b[m